        <mxCell id="source_a1" value="&lt;div style=&quot;font-family:Helvetica;font-size:10px;line-height:125%;text-align:left;&quot;&gt;&lt;b style=&quot;color:#0f4691;&quot;&gt;A1 · policy&lt;/b&gt;&lt;br&gt;Jeb Bush and Marco Rubio had it set so that the winner takes everything in the Florida primary.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=0.5;strokeColor=#779ed5;fillColor=#f0f4fb;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="s1">
