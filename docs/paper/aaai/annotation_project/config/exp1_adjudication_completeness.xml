<View>
  <View name="meta" style="background:#f5f5f5;padding:8px 12px;border-radius:4px;margin-bottom:12px">
    <Text name="meta_id" value="仲裁 ID: $adjudication_id  |  数据集: $dataset  |  样本: $event_id" />
    <Text name="requested_fields" value="本条仲裁字段：完整性 Completeness" style="font-size:15px;font-weight:bold;color:#c62828;margin-top:6px" />
  </View>

  <View name="blind_notice" style="border-left:4px solid #ff9800;padding:8px 12px;margin-bottom:14px;background:#fff8e1">
    <Text name="blind_notice_text" value="请独立判断，不查询 Yulin/Zhiqiang 的原标签。英文为准，中文仅辅助理解。完整性是 claim 级判断，本页只提交一次。" style="font-size:12px;color:#7a4f00" />
  </View>

  <View name="claim_block" style="border-left:4px solid #2196F3;padding:8px 12px;margin-bottom:14px;background:#fafafa">
    <Text name="claim_heading" value="Claim" style="font-size:14px;font-weight:bold;color:#1565c0" />
    <Text name="claim" value="$claim" style="font-size:15px;line-height:1.6" />
    <Text name="claim_zh_heading" value="中文辅助：" style="font-size:11px;color:#888;margin-top:5px" />
    <Text name="claim_zh" value="$claim_zh" style="font-size:13px;line-height:1.5;color:#666" />
  </View>

  <View name="atoms_block" style="border-left:4px solid #9c27b0;padding:8px 12px;margin-bottom:14px;background:#faf7ff">
    <Text name="atoms_heading" value="该 Claim 的全部 Atoms" style="font-size:14px;font-weight:bold;color:#7b1fa2" />
    <Text name="all_atoms_text" value="$all_atoms_text" style="font-size:14px;line-height:1.7;white-space:pre-wrap" />
    <Text name="atoms_zh_heading" value="中文辅助：" style="font-size:11px;color:#888;margin-top:5px" />
    <Text name="all_atoms_text_zh" value="$all_atoms_text_zh" style="font-size:13px;line-height:1.6;color:#666;white-space:pre-wrap" />
  </View>

  <View name="completeness_block" style="border:1px solid #e0e0e0;border-radius:6px;padding:10px 14px;margin-bottom:12px">
    <Header value="完整性 Completeness" style="font-size:13px" />
    <Text name="completeness_hint" value="Claim 中有多少个可独立验证的事实断言没有被上方全部 atoms 合起来覆盖？" style="font-size:12px;color:#666" />
    <Choices name="completeness_missed" toName="claim" choice="single" required="true">
      <Choice value="0" hint="全部覆盖" />
      <Choice value="1" hint="漏掉 1 个独立断言" />
      <Choice value="2" hint="漏掉 2 个独立断言" />
      <Choice value="3+" hint="漏掉 3 个或更多独立断言" />
    </Choices>
  </View>

  <Header value="仲裁说明（可选）" style="font-size:12px" />
  <TextArea name="notes" toName="claim" rows="3" placeholder="如判断为非 0，建议写明遗漏了什么断言" />

  <View name="confirm_block" style="background:#e8f5e9;padding:8px 12px;border-radius:4px;margin-top:12px">
    <Choices name="review_complete" toName="claim" choice="single" required="true">
      <Choice value="confirmed" hint="我已独立完成本条完整性仲裁，未查看 A/B 原标签" />
    </Choices>
  </View>
</View>
